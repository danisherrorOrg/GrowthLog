# Docker Compose settings. Copy to .env and fill in:  cp .env.example .env

# Required. Generate with: openssl rand -hex 32
JWT_SECRET=

# Where the browser reaches the frontend and the API
ALLOWED_ORIGINS=http://localhost:3000
API_PUBLIC_URL=http://localhost:8000

# Login session cookie. This compose setup serves plain http, so Secure is off by default;
# set AUTH_COOKIE_SECURE=true when serving over HTTPS.
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAMESITE=lax

# Comma-separated IPs/CIDRs of reverse proxies in front of the API (e.g. Cloudflare,
# a load balancer). Only these may set X-Forwarded-For / CF-Connecting-IP for rate
# limiting. Leave empty when clients connect to the API directly.
TRUSTED_PROXIES=

# Optional: protects POST /admin/nudge-silent-users
ADMIN_TOKEN=

# Optional: email (see backend/.env.example for provider settings)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SENDER=GrowthLog <noreply@growthlog.app>
