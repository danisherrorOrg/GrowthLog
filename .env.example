# Docker Compose settings. Copy to .env and fill in:  cp .env.example .env

# Required. Generate with: openssl rand -hex 32
JWT_SECRET=

# Where the browser reaches the frontend and the API
ALLOWED_ORIGINS=http://localhost:3000
API_PUBLIC_URL=http://localhost:8000

# Optional: protects POST /admin/nudge-silent-users
ADMIN_TOKEN=

# Optional: email (see backend/.env.example for provider settings)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SENDER=GrowthLog <noreply@growthlog.app>
