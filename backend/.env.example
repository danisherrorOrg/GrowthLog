# --- MongoDB Configuration ---
# Example: mongodb+srv://<user>:<password>@cluster.mongodb.net/dbname
MONGO_URL=mongodb://localhost:27017/growthlog

# --- Security ---
# Generate a secret: openssl rand -hex 32
JWT_SECRET=your_super_secret_jwt_key_here

# --- CORS Settings ---
# Comma-separated list of allowed origins (no trailing slash)
ALLOWED_ORIGINS=http://localhost:3000

# --- Auth cookie ---
# The login session is an httpOnly cookie. Keep AUTH_COOKIE_SECURE=true in production (HTTPS);
# false is only for local http:// development (Safari won't store Secure cookies on http).
# If the frontend and API are on different sites (e.g. *.vercel.app + *.onrender.com), set
# AUTH_COOKIE_SAMESITE=none (requires AUTH_COOKIE_SECURE=true).
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAMESITE=lax

# Comma-separated IPs/CIDRs of reverse proxies in front of the API (e.g. Cloudflare,
# a load balancer). Only these may set X-Forwarded-For / CF-Connecting-IP for rate
# limiting. Leave empty when clients connect to the API directly.
TRUSTED_PROXIES=

# --- Email (SMTP) Configuration ---
# Required for verification emails and daily nudges. Any SMTP provider works:
#   Resend:   SMTP_HOST=smtp.resend.com    SMTP_PORT=465  SMTP_USER=resend  SMTP_PASS=<API key>
#   SendGrid: SMTP_HOST=smtp.sendgrid.net  SMTP_PORT=587  SMTP_USER=apikey  SMTP_PASS=<API key>
#   Gmail:    SMTP_HOST=smtp.gmail.com     SMTP_PORT=587  (use an App Password)
# If unset, emails are skipped and a warning is logged.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
SMTP_SENDER=GrowthLog <your_email@gmail.com>
